# 初始化端口（假设使用端口0和1）

set 0 rate 20
set 1 rate 50
start all
set all size 1518
delay 10000      
set 0 rate 50
set 1 rate 20
delay 10000
set 0 rate 20
set 1 rate 50
delay 10000
set 0 rate 50
set 1 rate 20
delay 10000         
set 0 rate 20
set 1 rate 50
delay 10000    
set 0 rate 50
set 1 rate 20
delay 10000    
stop all